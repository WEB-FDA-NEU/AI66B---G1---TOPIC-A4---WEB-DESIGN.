DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Passwords for the accounts created by scripts/seed.py (only used when an account is
# first created). Leave unset to have the seed generate and print a random password.
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

# Secret used to sign/verify JWT access tokens. Use a long random value per environment,
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))". Never commit it.
JWT_SECRET=
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# Development only: accept the forgeable X-User-Id header. Never set this in production.
# ALLOW_DEV_USER_HEADER=1
