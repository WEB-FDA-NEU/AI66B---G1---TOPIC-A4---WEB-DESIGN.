# Application Settings
APP_NAME=Concertly API
APP_ENV=development
DEBUG=True
PORT=8000

# Security & Authentication
SECRET_KEY=concertly-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
DATABASE_URL=sqlite:///./concertly.db

# CORS Configuration (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,*

# Business Rules
RESERVATION_TTL_SECONDS=300
MAX_SEATS_PER_RESERVATION=8
EXPIRY_SWEEP_INTERVAL=30
JWT_SECRET=my-super-secret-jwt-key-for-concertly